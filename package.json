{
  "name": "tweet-stream-landing-page",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "vite build && node scripts/build-pages.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "test:production": "node scripts/check-production.mjs",
    "format": "prettier --write src scripts tests *.js *.html *.json"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.2.8",
    "@fontsource/dm-sans": "^5.2.8",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "vite": "^7.1.7"
  }
}
